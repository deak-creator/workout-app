{"id":"cottage-berries","name":"Cottage Cheese & Berries","emoji":"🍓","category":"snack","minutes":2,"servings":1,"vegetarian":true,"ingredients":[{"food":"cottage","grams":150,"qty":150,"unit":"g","label":"cottage cheese"},{"food":"berries","grams":80,"qty":80,"unit":"g","label":"mixed berries"},{"food":"honey","grams":5,"qty":1,"unit":"tsp","label":"honey"}],"steps":["Top the cottage cheese with berries and honey."]},{"id":"protein-smoothie","name":"Peanut Butter Protein Smoothie","emoji":"🥤","category":"snack","minutes":5,"servings":1,"vegetarian":true,"ingredients":[{"food":"skim","grams":300,"qty":300,"unit":"ml","label":"skim milk"},{"food":"banana","grams":120,"qty":1,"unit":"","label":"frozen banana"},{"food":"whey","grams":30,"qty":1,"unit":"scoop","label":"protein powder"},{"food":"pb","grams":15,"qty":1,"unit":"tbsp","label":"peanut butter"},{"food":"oats","grams":20,"qty":2,"unit":"tbsp","label":"rolled oats"}],"steps":["Blend everything with a handful of ice until smooth."]},{"id":"hummus-veg","name":"Hummus & Veggie Sticks","emoji":"🥕","category":"snack","minutes":5,"servings":1,"vegetarian":true,"ingredients":[{"food":"hummus","grams":60,"qty":4,"unit":"tbsp","label":"hummus"},{"food":"carrot","grams":80,"qty":1,"unit":"","label":"carrot, in sticks"},{"food":"cucumber","grams":80,"qty":0.5,"unit":"","label":"cucumber, in sticks"},{"food":"capsicum","grams":60,"qty":0.5,"unit":"","label":"capsicum, in strips"}],"steps":["Cut the vegetables into sticks and serve with hummus."]},{"id":"energy-balls","name":"Protein Energy Balls","emoji":"🍫","category":"snack","minutes":15,"servings":6,"vegetarian":true,"ingredients":[{"food":"oats","grams":120,"qty":1.25,"unit":"cups","label":"rolled oats"},{"food":"pb","grams":120,"qty":0.5,"unit":"cup","label":"peanut butter"},{"food":"honey","grams":60,"qty":3,"unit":"tbsp","label":"honey"},{"food":"whey","grams":60,"qty":2,"unit":"scoops","label":"protein powder"},{"food":"darkchoc","grams":40,"qty":40,"unit":"g","la