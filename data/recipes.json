e,"ingredients":[{"food":"oats","grams":50,"qty":0.5,"unit":"cup","label":"rolled oats"},{"food":"skim","grams":150,"qty":150,"unit":"ml","label":"skim milk"},{"food":"greekyog","grams":100,"qty":100,"unit":"g","label":"Greek yoghurt"},{"food":"whey","grams":15,"qty":0.5,"unit":"scoop","label":"vanilla protein powder"},{"food":"chia","grams":10,"qty":2,"unit":"tsp","label":"chia seeds"},{"food":"berries","grams":80,"qty":80,"unit":"g","label":"mixed berries"},{"food":"honey","grams":5,"qty":1,"unit":"tsp","label":"honey"}],"steps":["Stir the oats, milk, yoghurt, protein powder and chia seeds together in a jar.","Cover and refrigerate overnight (or at least 4 hours).","Top with berries and a drizzle of honey before eating."]},{"id":"scrambled-eggs","name":"Scrambled Eggs on Toast","emoji":"🍳","category":"breakfast","minutes":10,"servings":1,"vegetarian":true,"ingredients":[{"food":"egg","grams":150,"qty":3,"unit":"","label":"eggs"},{"food":"skim","grams":20,"qty":1,"unit":"tbsp","label":"skim milk"},{"food":"bread","grams":80,"qty":2,"unit":"slices","label":"wholemeal bread"},{"food":"spinach","grams":30,"qty":1,"unit":"handful","label":"baby spinach"},{"food":"oil","grams":5,"qty":1,"unit":"tsp","label":"olive oil"}],"steps":["Whisk the eggs and milk with a pinch of salt and pepper.","Heat the oil in a non-stick pan over low-medium heat and wilt the spinach.","Add the eggs and stir gently until just set.","Serve on toasted wholemeal bread."]},{"id":"yoghurt-bowl","name":"Greek Yoghurt Berry Bowl","emoji":"🫐","category":"breakfast","minutes":5,"servings":1,"vegetarian":true,"ingredients":[{"food":"greekyog","grams":200,"qty":200,"unit":"g","label":"Greek yoghurt"},{"food":"berries","grams":100,"qty":100,"unit":"g","label":"mixed berries"},{"food":"almonds","grams":15,"qty":10,"unit":"","label":"almonds, chopped"},{"food":"chia","grams":5,"qty":1,"unit":"tsp","label":"chia seeds"},{"food":"honey","grams":10,"qty":2,"unit":"tsp","label":"honey"}],"steps":["Spoon the yoghurt into a bowl.","Top with berries, chopped almonds and chia seeds.","Drizzle with honey."]},{"id":"protein-pancakes","name":"Banana Protein Pancakes","emoji":"🥞","category":"breakfast","minutes":20,"servings":2,"vegetarian":true,"ingredients":[{"food":"oats","grams":80,"qty":0.75,"unit":"cup","label":"rolled oats"},{"food":"banana","grams":120,"qty":1,"unit":"large","label":"ripe banana"},{"food":"egg","grams":100,"qty":2,"unit":"","label":"eggs"},{"food":"eggwhite","grams":100,"qty":100,"unit":"ml","label":"egg whites"},{"food":"whey","grams":30,"qty":1,"unit":"scoop","label":"protein powder"},{"food":"berries","grams":100,"qty":100,"unit":"g","label":"berries, to serve"},{"food":"maple","grams":20,"qty":1,"unit":"tbsp","label":"maple syrup"}],"steps":["Blend the oats into a flour, then add banana, eggs, egg whites and protein powder and blend until smooth.","Rest the batter for 5 minutes.","Cook ¼-cup portions in a non-stick pan over medium heat, about 2 minutes each side.","Serve with berries and maple syrup."]},{"id":"egg-muffins","name":"Veggie Egg Muffins","emoji":"🧁","category":"breakfast","minutes":30,"servings":3,"vegetarian":true,"ingredients":[{"food":"egg","grams":400,"qty":8,"unit":"","label":"eggs"},{"food":"spinach","grams":60,"qty":2,"unit":"handfuls","label":"baby spinach, chopped"},{"food":"capsicum","grams":100,"qty":1,"unit":"","label":"capsicum, diced"},{"food":"onion","grams":50,"qty":0.5,"unit":"","label":"onion, finely diced"},{"food":"tomato","grams":100,"qty":100,"unit":"g","label":"cherry tomatoes, halved"},{"food":"feta","grams":60,"qty":60,"unit":"g","label":"feta, crumbled"}],"steps":["Preheat the oven to 180 °C and grease a 6-hole muffin tray (makes 6 large muffins, 2 per serve).","Divide the vegetables and feta between the holes.","Whisk the eggs with salt and pepper and pour over the vegetables.","Bake for 20–22 minutes until set. Keeps 4 days in the fridge."]},{"id":"avo-toast","name":"Avocado Toast with Eggs","emoji":"🥑","category":"breakfast","minutes":10,"servings":1,"vegetarian":true,"ingredients":[{"food":"bread","grams":80,"qty":2,"unit":"slices","label":"wholemeal bread"},{"food":"avocado","grams":50,"qty":0.25,"unit":"","label":"avocado"},{"food":"egg","grams":100,"qty":2,"unit":"","label":"eggs"},{"food":"tomato","grams":50,"qty":50,"unit":"g","label":"cherry tomatoes, sliced"},{"food":"lemon","grams":5,"qty":1,"unit":"tsp","label":"lemon juice"}],"steps":["Poach or fry the eggs to your liking.","Mash the avocado with lemon juice, salt and pepper.","Spread on toast, top with the eggs and tomatoes."]},{"id":"chicken-quinoa-salad","name":"Chicken & Quinoa Salad","emoji":"🥗","category":"lunch","minutes":20,"servings":2,"vegetarian":false,"ingredients":[{"food":"chicken","grams":300,"qty":300,"unit":"g","label":"chicken breast"},{"food":"quinoa","grams":300,"qty":1.5,"unit":"cups","label":"cooked quinoa"},{"food":"spinach","grams":60,"qty":2,"unit":"handfuls","label":"baby spinach"},{"food":"tomato","grams":150,"qty":150,"unit":"g","label":"cherry tomatoes, halved"},{"food":"cucumber","grams":100,"qty":1,"unit":"","label":"Lebanese cucumber, diced"},{"food":"feta","grams":50,"qty":50,"unit":"g","label":"feta"},{"food":"oil","grams":15,"qty":1,"unit":"tbsp","label":"olive oil"},{"food":"lemon","grams":20,"qty":1,"unit":"tbsp","label":"lemon juice"}],"steps":["Season the chicken and cook in a hot pan for 5–6 minutes each side until cooked through. Rest, then slice.","Toss the quinoa, spinach, tomatoes and cucumber in a bowl.","Whisk the oil and lemon juice, pour over the salad and toss.","Top with the chicken and crumbled feta."]},{"id":"tuna-wrap","name":"Tuna Salad Wrap","emoji":"🌯","category":"lunch","minutes":5,"servings":1,"vegetarian":false,"ingredients":[{"food":"wrap","grams":60,"qty":1,"unit":"","label":"wholemeal wrap"},{"food":"tuna","grams":95,"qty":1,"unit":"can (95 g)","label":"tuna in springwater, drained"},{"food":"greekyog","grams":30,"qty":1,"unit":"tbsp","label":"Greek yoghurt"},{"food":"leaves","grams":30,"qty":1,"unit":"handful","label":"salad leaves"},{"food":"cucumber","grams":40,"qty":0.25,"unit":"","label":"cucumber, sliced"},{"food":"tomato","grams":40,"qty":40,"unit":"g","label":"cherry tomatoes, sliced"}],"steps":["Mix the tuna with the yoghurt, salt and pepper.","Lay the salad on the wrap, add the tuna and roll up tightly."]},{"id":"burrito-bowl","name":"Chicken Burrito Bowl","emoji":"🌮","category":"lunch","minutes":25,"servings":2,"vegetarian":false,"ingredients":[{"food":"chicken","grams":300,"qty":300,"unit":"g","label":"chicken breast"},{"food":"taco","grams":10,"qty":2,"unit":"tsp","label":"taco seasoning"},{"food":"brownrice","grams":300,"qty":1.5,"unit":"cups","label":"cooked brown rice"},{"food":"beans","grams":150,"qty":150,"unit":"g","label":"black beans, drained"},{"food":"corn","grams":100,"qty":100,"unit":"g","label":"corn kernels"},{"food":"salsa","grams":100,"qty":100,"unit":"g","label":"tomato salsa"},{"food":"avocado","grams":80,"qty":0.5,"unit":"","label":"avocado, sliced"},{"food":"leaves","grams":40,"qty":1,"unit":"handful","label":"shredded lettuce"}],"steps":["Coat the chicken in taco seasoning and cook in a hot pan for 5–6 minutes each side. Slice.","Warm the rice, beans and corn.","Divide between two bowls with lettuce, salsa, avocado and the chicken."]},{"id":"lentil-soup","name":"Lentil & Vegetable Soup","emoji":"🍲","category":"lunch","minutes":35,"servings":4,"vegetarian":true,"ingredients":[{"food":"oil","grams":15,"qty":1,"unit":"tbsp","label":"olive oil"},{"food":"onion","grams":150,"qty":1,"unit":"","label":"onion, diced"},{"food":"carrot","grams":150,"qty":2,"unit":"","label":"carrots, diced"},{"food":"garlic","grams":10,"qty":3,"unit":"cloves","label":"garlic, crushed"},{"food":"lentils","grams":400,"qty":2,"unit":"cans","label":"lentils, drained"},{"food":"cantom","grams":400,"qty":1,"unit":"can","label":"diced tomatoes"},{"food":"spinach","grams":80,"qty":2,"unit":"handfuls","label":"baby spinach"}],"steps":["Heat the oil in a large pot and cook the onion, carrot and garlic for 5 minutes.","Add the lentils, tomatoes and 750 ml water or stock. Simmer for 20 minutes.","Stir through the spinach until wilted and season to taste. Freezes well."]},{"id":"hummus-chicken-wrap","name":"Hummus Chicken Wrap","emoji":"🫓","category":"lunch","minutes":10,"servings":1,"vegetarian":false,"ingredients":[{"food":"wrap","grams":60,"qty":1,"unit":"","label":"wholemeal wrap"},{"food":"chicken","grams":100,"qty":100,"unit":"g","label":"cooked chicken breast, sliced"},{"food":"hummus","grams":30,"qty":2,"unit":"tbsp","label":"hummus"},{"food":"spinach","grams":20,"qty":1,"unit":"handful","label":"baby spinach"},{"food":"capsicum","grams":40,"qty":0.25,"unit":"","label":"capsicum, sliced"}],"steps":["Spread the hummus over the wrap.","Add the spinach, capsicum and chicken, then roll up."]},{"id":"egg-fried-rice","name":"Veggie Egg Fried Rice","emoji":"🍚","category":"lunch","minutes":15,"servings":2,"vegetarian":true,"ingredients":[{"food":"oil","grams":10,"qty":2,"unit":"tsp","label":"olive oil"},{"food":"onion","grams":50,"qty":0.5,"unit":"","label":"onion, diced"},{"food":"carrot","grams":80,"qty":1,"unit":"","label":"carrot, diced"},{"food":"peas","grams":100,"qty":100,"unit":"g","label":"frozen peas"},{"food":"brownrice","grams":400,"qty":2,"unit":"cups","label":"cooked brown rice (day-old works best)"},{"food":"egg","grams":150,"qty":3,"unit":"","label":"eggs, beaten"},{"food":"soy","grams":20,"qty":1,"unit":"tbsp","label":"soy sauce"}],"steps":["Heat the oil in a wok and stir-fry the onion and carrot for 3 minutes.","Add the peas and rice and stir-fry until hot.","Push the rice aside, scramble the eggs in the space, then mix through.","Season with soy sauce."]},{"id":"honey-soy-stirfry","name":"Honey Soy Chicken Stir-Fry","emoji":"🥡","category":"dinner","minutes":20,"servings":2,"vegetarian":false,"ingredients":[{"food":"chicken","grams":350,"qty":350,"unit":"g",