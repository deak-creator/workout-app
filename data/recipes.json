label":"onion, diced"},{"food":"carrot","grams":100,"qty":1,"unit":"","label":"carrot, grated"},{"food":"garlic","grams":10,"qty":3,"unit":"cloves","label":"garlic, crushed"},{"food":"beef","grams":500,"qty":500,"unit":"g","label":"lean beef mince"},{"food":"passata","grams":700,"qty":1,"unit":"jar (700 g)","label":"tomato passata"},{"food":"pasta","grams":320,"qty":320,"unit":"g","label":"dry spaghetti"},{"food":"parmesan","grams":30,"qty":30,"unit":"g","label":"parmesan, grated"}],"steps":["Cook the onion, carrot and garlic in the oil for 5 minutes.","Add the mince and brown, breaking it up.","Add the passata, season and simmer for 20 minutes.","Cook the spaghetti, then serve topped with the sauce and parmesan."]},{"id":"beef-tacos","name":"Lean Beef Tacos","emoji":"🌮","category":"dinner","minutes":20,"servings":2,"vegetarian":false,"ingredients":[{"food":"beef","grams":250,"qty":250,"unit":"g","label":"lean beef mince"},{"food":"taco","grams":15,"qty":1,"unit":"tbsp","label":"taco seasoning"},{"food":"wrap","grams":160,"qty":4,"unit":"small","label":"tortillas"},{"food":"salsa","grams":100,"qty":100,"unit":"g","label":"tomato salsa"},{"food":"leaves","grams":40,"qty":1,"unit":"handful","label":"shredded lettuce"},{"food":"tasty","grams":30,"qty":30,"unit":"g","label":"tasty cheese, grated"},{"food":"greekyog","grams":50,"qty":2,"unit":"tbsp","label":"Greek yoghurt"}],"steps":["Brown the mince, add the taco seasoning and a splash of water and simmer for 3 minutes.","Warm the tortillas.","Fill with mince, lettuce, salsa, cheese and a spoon of yoghurt."]},{"id":"thai-curry","name":"Thai Red Chicken Curry","emoji":"🍛","category":"dinner","minutes":30,"servings":4,"vegetarian":false,"ingredients":[{"food":"curry","grams":50,"qty":3,"unit":"tbsp","label":"red curry paste"},{"food":"thigh","grams":600,"qty":600,"unit":"g","label":"chicken thigh, diced"},{"food":"coconut","grams":400,"qty":1,"unit":"can (400 ml)","label":"light coconut milk"},{"food":"capsicum","grams":1